<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Tema aplicado mientras el proceso arranca (splash screen).
        ✅ windowFullscreen ELIMINADO — ocultaba la status bar desde el primer
           frame, antes de que Flutter pudiera mostrar batería/señal/hora.
        ✅ windowDrawsSystemBarBackgrounds = true  → Android deja que la app
           controle el color de las barras (necesario para que Flutter las pinte).
        ✅ statusBarColor / navigationBarColor transparentes → Flutter los controla.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- ❌ ELIMINADO: android:windowFullscreen = true
             Era el responsable de ocultar la status bar en cada arranque/reinicio.
             Sin este flag la status bar (batería, señal, hora) queda visible
             desde el primer frame sin necesidad de activar/desactivar kiosco. -->
    </style>

    <!--
        Tema aplicado en cuanto el motor Flutter dibuja su primer frame.
        Debe ser consistente con LaunchTheme para evitar parpadeos.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>